# ============================================
# Arivu — Environment Variables (Template)
# ============================================

# --- Twilio (Layer 1: Telephony) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
AGENT_PHONE_NUMBER=+91XXXXXXXXXX

# --- Sarvam AI (Layer 2-3: Voice + Brain) ---
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Cloud / Gemini ---
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BRAIN_LLM_PROVIDER=gemini
BRAIN_USE_UNIFIED=1

# --- Supabase (Layer 4-5: Dashboard + Learning Loop) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Service URLs ---
VOICE_SERVICE_URL=http://localhost:8000
BRAIN_SERVICE_URL=http://localhost:8002
DASHBOARD_API_URL=http://localhost:8001

# --- ngrok (dev only) ---
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NGROK_DOMAIN=arivu-dev.ngrok-free.app
